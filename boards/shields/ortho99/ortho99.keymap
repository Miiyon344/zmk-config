#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                /* SW1 - SW15 */
                &kp A &kp B &none &none &none
                &none &none &none &kp C &kp D
                &none &none &none &none &none

                /* SW16 - SW33 */
                &none &none &none &none &none
                &none &none &none &none &none
                &none &none &none &none &none
                &none &kp E &kp F

                /* SW34 - SW51 */
                &none &none &none &none &none
                &none &none &none &none &none
                &none &none &none &none &none
                &none &none &none

                /* SW52 - SW67 */
                &none &none &none &none
                &none &none &none &none
                &none &none &none &none
                &none &none &none &none

                /* SW68 - SW85 */
                &none &none &none &none &none
                &none &none &none &none &none
                &none &none &none &none &none
                &none &none &none

                /* SW86 - SW99 */
                &none &none &none &none &none
                &none &none &none &none &none
                &none &none &none &none
            >;
        };
    };
};