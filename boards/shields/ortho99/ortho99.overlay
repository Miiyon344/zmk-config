#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        /*
         * COL0      = XIAO D8
         * COL1-8    = MCP23017 GPA0-7
         * COL9-16   = MCP23017 GPB0-7
         * COL17     = XIAO D9
         */
        col-gpios
            = <&xiao_d 8 GPIO_ACTIVE_HIGH>
            , <&mcp23017 0 GPIO_ACTIVE_HIGH>
            , <&mcp23017 1 GPIO_ACTIVE_HIGH>
            , <&mcp23017 2 GPIO_ACTIVE_HIGH>
            , <&mcp23017 3 GPIO_ACTIVE_HIGH>
            , <&mcp23017 4 GPIO_ACTIVE_HIGH>
            , <&mcp23017 5 GPIO_ACTIVE_HIGH>
            , <&mcp23017 6 GPIO_ACTIVE_HIGH>
            , <&mcp23017 7 GPIO_ACTIVE_HIGH>
            , <&mcp23017 8 GPIO_ACTIVE_HIGH>
            , <&mcp23017 9 GPIO_ACTIVE_HIGH>
            , <&mcp23017 10 GPIO_ACTIVE_HIGH>
            , <&mcp23017 11 GPIO_ACTIVE_HIGH>
            , <&mcp23017 12 GPIO_ACTIVE_HIGH>
            , <&mcp23017 13 GPIO_ACTIVE_HIGH>
            , <&mcp23017 14 GPIO_ACTIVE_HIGH>
            , <&mcp23017 15 GPIO_ACTIVE_HIGH>
            , <&xiao_d 9 GPIO_ACTIVE_HIGH>
            ;

        /*
         * ROW0-3 = XIAO D0-D3
         * ROW4   = XIAO D6
         * ROW5   = XIAO D7
         */
        row-gpios
            = <&xiao_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };


    default_transform: keymap_transform0 {
    compatible = "zmk,matrix-transform";

    rows = <6>;
    columns = <18>;

    map = <
        /* ROW0 : SW1 - SW15 */
        RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)
        RC(0,5)  RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)
        RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)

        /* ROW1 : SW16 - SW33 */
        RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)  RC(1,4)
        RC(1,5)  RC(1,6)  RC(1,7)  RC(1,8)  RC(1,9)
        RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14)
        RC(1,15) RC(1,16) RC(1,17)

        /* ROW2 : SW34 - SW51 */
        RC(2,0)  RC(2,1)  RC(2,2)  RC(2,3)  RC(2,4)
        RC(2,5)  RC(2,6)  RC(2,7)  RC(2,8)  RC(2,9)
        RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14)
        RC(2,15) RC(2,16) RC(2,17)

        /* ROW3 : SW52 - SW67 */
        RC(3,0)  RC(3,1)  RC(3,2)  RC(3,3)  RC(3,4)
        RC(3,5)  RC(3,6)  RC(3,7)  RC(3,8)  RC(3,9)
        RC(3,10) RC(3,11) RC(3,12)
        RC(3,14) RC(3,15) RC(3,16)

        /* ROW4 : SW68 - SW85 */
        RC(4,0)  RC(4,1)  RC(4,2)  RC(4,3)  RC(4,4)
        RC(4,5)  RC(4,6)  RC(4,7)  RC(4,8)  RC(4,9)
        RC(4,10) RC(4,11) RC(4,12) RC(4,13) RC(4,14)
        RC(4,15) RC(4,16) RC(4,17)

        /* ROW5 : SW86 - SW99 */
        RC(5,0)  RC(5,1)  RC(5,2)  RC(5,3)  RC(5,4)
        RC(5,6)
        RC(5,8)  RC(5,9)  RC(5,10) RC(5,11) RC(5,12)
        RC(5,13) RC(5,14)
        RC(5,16)
    >;
    /*
     * Soft Off wake key
     *
     * Esc = ROW0 / COL0
     * ROW0 = XIAO D0
     * COL0 = XIAO D8
     */
    soft_off_keys {
        compatible = "gpio-keys";

        soft_off_gpio_key: soft_off_gpio_key {
            gpios = <&xiao_d 0
                (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        };
    };

    soft_off_wakeup: soft_off_wakeup {
        compatible = "zmk,gpio-key-wakeup-trigger";
        trigger = <&soft_off_gpio_key>;
        wakeup-source;

        /*
         * COL0をHighにしておき、
         * Esc押下でROW0をHighにする
         */
        extra-gpios =
            <&xiao_d 8 GPIO_ACTIVE_HIGH>;
    };

    soft_off_wakers {
        compatible = "zmk,soft-off-wakeup-sources";
        wakeup-sources = <&soft_off_wakeup>;
    };
};

    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };
};


/*
 * XIAO nRF52840
 *
 * D4 = SDA
 * D5 = SCL
 */
&xiao_i2c {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;

    mcp23017: mcp23017@20 {
        compatible = "microchip,mcp230xx";
        reg = <0x20>;

        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <16>;

        status = "okay";
    };
};